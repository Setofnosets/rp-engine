      {
        "chronicle": {
          "category": "event",
          "title": "Rumors of the Beast Conversion Program — Deadline",
          "summary": "The BCP stays entirely off the heroes' radar and converts a named hero off-screen as escalation."
        }
      }
    ],
    "nudge": "Rumors of the Beast Conversion Program — The first credible rumor surfaces that missing metahumans are being experimented on rather than killed. — The rumor may come from a victim, a defecting Clarity scientist, or a police file. The source does not matter; the reveal does.",
    "once": true
  },
  {
    "id": "s1.escalation.first-conversion",
