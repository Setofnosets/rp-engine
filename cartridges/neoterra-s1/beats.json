[
  {
    "id": "s1.opening.arms-deal",
    "act": "opening",
    "class": "gate",
    "flexibility": "strict",
    "priority": 990,
    "roles": {
      "lead": {
        "default": "s1.vaiva.colorgarde"
      }
    },
    "when": {
      "any": [
        {
          "at": "neon-docks"
        },
        {
          "at": "clarity-hq"
        }
      ]
    },
    "until": {
      "flag": "event_arms-deal",
      "value": true
    },
    "deadline": {
      "clock": "turn",
      "op": ">=",
      "value": 12
    },
    "deadlinePolicy": "close",
    "on_deadline": [
      {
        "chronicle": {
          "category": "event",
          "title": "The Illegal Arms Deal — Deadline",
          "summary": "Clarity ships the weapons unimpeded and gains a free escalation toward city control."
        }
      }
    ],
    "nudge": "The Illegal Arms Deal — Colorgarde interrupts one of Clarity's illegal arms deals, announcing herself as a real threat to the corporation. — Any public Clarity operation interrupted by Colorgarde counts. If Vaiva is not present, another hero or a vigilante may crash the deal instead.",
    "once": true
  },
  {
    "id": "s1.opening.beast-rumors",
